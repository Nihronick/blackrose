# ── Обязательные ──────────────────────────────────────────────
# ВАЖНО: то же значение что и BOT_TOKEN в backend/.env.example
BOT_TOKEN=your_bot_token_here

# ── Администраторы ────────────────────────────────────────────
ADMIN_USERS=123456789

# ── URLs ──────────────────────────────────────────────────────
MINIAPP_URL=https://nihronick.github.io/blackrose
# Бот и API живут в одном контейнере — localhost всегда постоянный
API_URL=http://localhost:8080

# ── Webhook (опционально, по умолчанию polling) ───────────────
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/bot/webhook
