# ── Обязательные ──────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Прямое подключение для миграций (без пулера)
DIRECT_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=generate_with_python_secrets_token_hex_32

# ── Администраторы ────────────────────────────────────────────
# Telegram user_id через запятую
ADMIN_USERS=123456789
# Первый локальный админ (логин:пароль) — создаётся при старте
ADMIN_PASSWORD=nihronn:your_secure_password

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=https://nihronick.github.io/blackrose
MINIAPP_URL=https://nihronick.github.io/blackrose

# ── Опциональные ──────────────────────────────────────────────
# Redis (Upstash)
REDIS_URL=rediss://default:password@your-url.upstash.io:6380

# Honeybadger — мониторинг ошибок
HONEYBADGER_API_KEY=

# Cloudflare R2 — хранилище медиафайлов
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=blackrose-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Публичный CDN URL для медиа (по умолчанию используется jsDelivr для GITHUB_REPO/GITHUB_BRANCH)
# Пример: https://cdn.jsdelivr.net/gh/Nihronick/blackrose@main
MEDIA_CDN_BASE=

# Оптимизация изображений при загрузке (конвертация в WebP при выигрыше в размере)
MEDIA_IMAGE_QUALITY=82
MEDIA_MAX_IMAGE_WIDTH=1920

# ── Runtime ───────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
