# ==============================================================================
# BlackRose Environment Configuration Example
# ==============================================================================
# Скопируйте этот файл в .env и заполните реальными данными.
# ВАЖНО: Никогда не коммитьте .env файл в репозиторий!

# === Базовые настройки бэкенда ===
# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Окружение (development, production)
ENVIRONMENT=production

# === Telegram Bot API ===
# Получите у @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Время жизни данных авторизации Telegram (в секундах). 86400 = 24ч.
INIT_DATA_MAX_AGE=86400

# === Безопасность и JWT ===
# Случайная строка для подписи JWT. Сгенерируйте: openssl rand -hex 32
JWT_SECRET=y0ur_sup3r_s3cr3t_jwt_k3y_h3r3
# Список ID администраторов Telegram (через запятую)
ADMIN_USERS=12345678,87654321

# === Базы данных ===
# PostgreSQL (рекомендуется v15+)
DATABASE_URL=postgresql://user:password@localhost:5432/blackrose
# Redis (для кеширования и очередей)
REDIS_URL=redis://localhost:6379/0

# === Внешние интеграции ===
# Honeybadger (мониторинг ошибок) — опционально
HONEYBADGER_API_KEY=

# === Настройки Frontend / PWA ===
# Основной URL фронтенда (для CORS и ссылок в уведомлениях)
FRONTEND_URL=https://nihronick.github.io/blackrose
# Если TMA запущен на другом домене (например, HF Spaces)
MINIAPP_URL=https://nihronick-blackrose-frontend.hf.space

# === Первичная настройка ===
# Локальный админ для первого входа (username:password)
INITIAL_ADMINS=admin:password123
