{
  "name": "blackrose-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "npx playwright test -c ../e2e/playwright.config.ts",
    "test:e2e:ui": "npx playwright test -c ../e2e/playwright.config.ts --ui",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "build:android": "npm run build && cap sync android",
    "build:ios": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@honeybadger-io/js": "^6.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.51.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.1.6",
    "fp-ts": "^2.16.11",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "marked": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.2",
    "react-window": "^2.2.7",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
